{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Heyrafiki Docs",
  "description": "The Heyrafiki API: authentication, errors and live resources.",
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "logo": {
    "light": "/images/logo-black.png",
    "dark": "/images/logo-white.png",
    "href": "/"
  },
  "favicon": {
    "light": "/images/mark-black.png",
    "dark": "/images/mark-white.png"
  },
  "colors": {
    "primary": "#184A34",
    "light": "#2F9E68",
    "dark": "#3D7B5C"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Instrument Sans"
    },
    "body": {
      "family": "Instrument Sans"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://heyrafiki.space"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Request access",
      "href": "https://heyrafiki.space/waitlist"
    }
  },
  "search": {
    "prompt": "Search Heyrafiki Docs"
  },
  "seo": {
    "indexing": "navigable"
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "authentication",
          "scopes",
          "environments",
          "requests",
          "errors"
        ]
      },
      {
        "group": "Build",
        "pages": ["sandbox", "testing", "sdks", "webhooks", "mcp"]
      },
      {
        "group": "API reference",
        "openapi": "openapi/heyrafiki.openapi.yaml",
        "pages": [
          "resources",
          "GET /",
          "GET /practitioners",
          "GET /practitioners/{practitioner_id}",
          "GET /practitioners/{practitioner_id}/availability",
          "GET /bookings",
          "POST /bookings",
          "GET /bookings/{booking_id}",
          "GET /sessions",
          "GET /sessions/{session_id}",
          "GET /claims",
          "GET /claims/{claim_id}",
          "GET /webhook_endpoints",
          "POST /webhook_endpoints",
          "GET /webhook_endpoints/{webhook_endpoint_id}",
          "DELETE /webhook_endpoints/{webhook_endpoint_id}",
          "POST /webhook_endpoints/{webhook_endpoint_id}/test",
          "rate-limits",
          "versioning"
        ]
      },
      {
        "group": "Platform",
        "pages": [
          "concepts/platform",
          "concepts/capabilities",
          "security/overview",
          "security/data-boundaries"
        ]
      },
      {
        "group": "Changelog",
        "pages": ["changelog"]
      }
    ]
  }
}
