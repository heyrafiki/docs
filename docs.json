{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Heyrafiki",
  "description": "Reference and integration guidance for the Heyrafiki API, Sandbox, insurance and institutional workflows.",
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "logo": {
    "light": "/images/logo-black.png",
    "dark": "/images/logo-white.png",
    "href": "/"
  },
  "favicon": {
    "light": "/images/mark-black.png",
    "dark": "/images/mark-white.png"
  },
  "colors": {
    "primary": "#184A34",
    "light": "#56C995",
    "dark": "#3D7B5C"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Instrument Sans"
    },
    "body": {
      "family": "Instrument Sans"
    }
  },
  "api": {
    "openapi": "openapi/heyrafiki.openapi.yaml",
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": ["bash", "javascript", "python", "go"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://heyrafiki.space"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Request access",
      "href": "https://heyrafiki.space/waitlist"
    }
  },
  "footer": {
    "socials": {
      "website": "https://heyrafiki.space",
      "github": "https://github.com/heyrafiki",
      "linkedin": "https://www.linkedin.com/company/heyrafiki",
      "x": "https://x.com/heyrafikios",
      "instagram": "https://www.instagram.com/heyrafikios"
    }
  },
  "search": {
    "prompt": "Search Heyrafiki Docs"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.heyrafiki.space",
      "og:locale": "en_KE"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "mcp", "cursor"]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Build",
        "icon": "code",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "authentication",
              "scopes",
              "environments",
              "requests",
              "errors"
            ]
          },
          {
            "group": "Integration tools",
            "pages": ["sandbox", "testing", "sdks", "webhooks", "mcp-server"]
          }
        ]
      },
      {
        "tab": "Insurance",
        "icon": "shield-check",
        "groups": [
          {
            "group": "Payer workflows",
            "pages": ["benefits", "claims"]
          },
          {
            "group": "Integration assurance",
            "pages": [
              "insurance/integration-guide",
              "insurance/financial-controls",
              "insurance/claim-valuation-timeline",
              "insurance/acceptance-testing"
            ]
          }
        ]
      },
      {
        "tab": "Institutions",
        "icon": "landmark",
        "groups": [
          {
            "group": "Institutional integration",
            "pages": [
              "concepts/institutions",
              "institutions/assurance-graph",
              "concepts/platform",
              "concepts/capabilities"
            ]
          },
          {
            "group": "Security and data governance",
            "pages": ["security/overview", "security/data-boundaries"]
          },
          {
            "group": "Research and evidence",
            "pages": ["research/evidence"]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "brackets-curly",
        "groups": [
          {
            "group": "REST API",
            "openapi": "openapi/heyrafiki.openapi.yaml",
            "pages": [
              "resources",
              "GET /",
              "GET /practitioners",
              "GET /practitioners/{practitioner_id}",
              "GET /practitioners/{practitioner_id}/availability",
              "GET /bookings",
              "POST /bookings",
              "GET /bookings/{booking_id}",
              "GET /sessions",
              "GET /sessions/{session_id}",
              "POST /coverages",
              "POST /coverage_batches",
              "POST /eligibility_checks",
              "GET /eligibility_checks/{eligibility_check_id}",
              "POST /preauthorizations",
              "GET /preauthorizations/{preauthorization_id}",
              "POST /preauthorizations/{preauthorization_id}/decisions",
              "GET /claims",
              "POST /claims",
              "GET /claims/{claim_id}",
              "GET /claims/{claim_id}/valuation",
              "POST /claims/{claim_id}/information_requests",
              "POST /claims/{claim_id}/evidence",
              "POST /claims/{claim_id}/adjudications",
              "GET /remittances",
              "POST /remittances",
              "GET /remittances/{remittance_id}",
              "GET /webhook_endpoints",
              "POST /webhook_endpoints",
              "GET /webhook_endpoints/{webhook_endpoint_id}",
              "DELETE /webhook_endpoints/{webhook_endpoint_id}",
              "POST /webhook_endpoints/{webhook_endpoint_id}/test",
              "rate-limits",
              "versioning"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "clock-rotate-left",
        "pages": ["changelog"]
      }
    ]
  }
}
