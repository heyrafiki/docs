{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Heyrafiki Docs",
  "description": "The Heyrafiki API: authentication, errors, resources and webhooks.",
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "logo": {
    "light": "/images/logo-black.png",
    "dark": "/images/logo-white.png",
    "href": "/"
  },
  "favicon": {
    "light": "/images/mark-black.png",
    "dark": "/images/mark-white.png"
  },
  "colors": {
    "primary": "#184A34",
    "light": "#2F9E68",
    "dark": "#3D7B5C"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Instrument Sans"
    },
    "body": {
      "family": "Instrument Sans"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://heyrafiki.space"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API keys",
      "href": "https://heyrafiki.space/waitlist"
    }
  },
  "search": {
    "prompt": "Search Heyrafiki Docs"
  },
  "seo": {
    "indexing": "navigable"
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "authentication", "errors"]
      },
      {
        "group": "API reference",
        "pages": ["resources", "webhooks"]
      },
      {
        "group": "Platform",
        "pages": ["concepts/platform", "security/overview"]
      },
      {
        "group": "Changelog",
        "pages": ["changelog"]
      }
    ]
  }
}
